    {
      "type": "timeseries",
      "title": "Requests per Pod",
      "description": "Should be roughly even. A skewed split points at long-lived connections pinned to one Pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pod) (rate(http_server_request_duration_seconds_count{namespace=\"$namespace\", app=\"$app\", pod=~\"$pod\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
